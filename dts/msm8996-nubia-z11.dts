	timer {
		compatible = "arm,armv8-timer";
		interrupts = <0x01 0x0d 0x08 0x01 0x0e 0x08 0x01 0x0b 0x08 0x01 0x0a 0x08>;
	};

	battery {
		compatible = "simple-battery";
		voltage-min-design-microvolt = <0x33e140>;
		voltage-max-design-microvolt = <0x432380>;
		charge-full-design-microamp-hours = <0x2dc6c0>;
		constant-charge-current-max-microamp = <0x2dc6c0>;
		phandle = <0x48>;
	};

	divclk1 {
		compatible = "gpio-gate-clock";
		clocks = <0x1f 0x2e>;
		#clock-cells = <0x00>;
		enable-gpios = <0x45 0x0f 0x00>;
		pinctrl-names = "default";
		pinctrl-0 = <0xcc>;
		phandle = <0xb2>;
	};

	divclk4 {
		compatible = "fixed-clock";
		#clock-cells = <0x00>;
		clock-frequency = <0x8000>;
		clock-output-names = "divclk4";
		pinctrl-names = "default";
		pinctrl-0 = <0xcd>;
		phandle = <0x95>;
	};

	gpio-keys {
		compatible = "gpio-keys";

		key-vol-up {
			label = "Volume Up";
			gpios = <0x45 0x02 0x01>;
			linux,code = <0x73>;
			wakeup-source;
			debounce-interval = <0x0f>;
		};

		key-dome {
			label = "Home";
			gpios = <0x3c 0x22 0x01>;
			linux,code = <0x66>;
			wakeup-source;
			debounce-interval = <0x0f>;
		};
	};

	irled {
		compatible = "pwm-ir-tx";
		pwms = <0xce 0x01 0xf4240>;
		pinctrl-names = "default";
		pinctrl-0 = <0xcf>;
	};

	vph-pwr-regulator {
		compatible = "regulator-fixed";
		regulator-name = "vph_pwr";
		regulator-min-microvolt = <0x39fbc0>;
		regulator-max-microvolt = <0x39fbc0>;
		regulator-always-on;
		regulator-boot-on;
		phandle = <0x14>;
	};

	vdd-cam-1p1 {
		compatible = "regulator-fixed";
		regulator-name = "vdd_cam_1p1";
		regulator-min-microvolt = <0x10c8e0>;
		regulator-max-microvolt = <0x10c8e0>;
		vin-supply = <0x16>;
		regulator-allow-set-load;
		gpio = <0x3c 0x56 0x00>;
		enable-active-high;
		pinctrl-names = "default";
		pinctrl-0 = <0xd0>;
	};

	vdd-3v2-tp {
		compatible = "regulator-fixed";
		regulator-name = "vdd_3v2_tp";
		regulator-min-microvolt = <0x30d400>;
		regulator-max-microvolt = <0x30d400>;
		startup-delay-us = <0xfa0>;
		vin-supply = <0x14>;
		gpio = <0x3c 0x49 0x00>;
		enable-active-high;
		phandle = <0xaa>;
	};

	rome-vreg {
		compatible = "regulator-fixed";
		regulator-name = "vdd_3v3";
		regulator-min-microvolt = <0x325aa0>;
		regulator-max-microvolt = <0x325aa0>;
		startup-delay-us = <0xfa0>;
		vin-supply = <0x18>;
		gpio = <0x45 0x09 0x00>;
		enable-active-high;
		pinctrl-names = "default";
		pinctrl-0 = <0xd1>;
		regulator-always-on;
	};

	wlan-en-1-8v {
		compatible = "regulator-fixed";
		regulator-name = "wlan-en-regulator";
		regulator-min-microvolt = <0x1b7740>;
		regulator-max-microvolt = <0x1b7740>;
		gpio = <0x45 0x08 0x00>;
		startup-delay-us = <0x11170>;
		enable-active-high;
		pinctrl-names = "default";
		pinctrl-0 = <0xd2>;
		phandle = <0x4e>;
	};

	divclk2 {
		compatible = "fixed-clock";
		#clock-cells = <0x00>;
		clock-frequency = <0x8000>;
		clock-output-names = "divclk2";
		pinctrl-names = "default";
		pinctrl-0 = <0xd3>;
	};
};
