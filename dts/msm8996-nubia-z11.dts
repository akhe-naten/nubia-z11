	reserved-memory {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;

		memory@85800000 {
			reg = <0x00 0x85800000 0x00 0x600000>;
			no-map;
				splash_region: splash@83400000 {
			reg = <0x00 0x83400000 0x00 0x23ff000>;
		};
};

		memory@85e00000 {
			reg = <0x00 0x85e00000 0x00 0x200000>;
