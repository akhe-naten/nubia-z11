/dts-v1/;

/ {
	interrupt-parent = <0x01>;
	#address-cells = <0x02>;
	#size-cells = <0x02>;
	model = "Nubia Z11 (NX531J)";
	compatible = "nubia,z11", "qcom,msm8996";
	chassis-type = "handset";
	qcom,msm-id = <0xf6 0x30001>;
	qcom,pmic-id = <0x20009 0x2000a 0x00 0x00>;
	qcom,board-id = <0x1f 0x00 0x20 0x00>;

	chosen {
	};

	framebuffer@83401000 {
		compatible = "simple-framebuffer";
		reg = <0x00 0x83401000 0x00 0x7e9000>;
		width = <0x438>;
		height = <0x780>;
		stride = <0x10e0>;
		format = "a8r8g8b8";
		status = "okay";
	};

	clocks {

		xo-board {
			compatible = "fixed-clock";
			#clock-cells = <0x00>;
			clock-frequency = <0x124f800>;
			clock-output-names = "xo_board";
			phandle = <0x12>;
		};

		sleep-clk {
			compatible = "fixed-clock";
			#clock-cells = <0x00>;
			clock-frequency = <0x7ffc>;
			clock-output-names = "sleep_clk";
			phandle = <0x20>;
		};
	};

	cpus {
		#address-cells = <0x02>;
		#size-cells = <0x00>;

		cpu@0 {
			device_type = "cpu";
			compatible = "qcom,kryo";
			reg = <0x00 0x00>;
			enable-method = "psci";
			cpu-idle-states = <0x02>;
			capacity-dmips-mhz = <0x400>;
			clocks = <0x03 0x00>;
			interconnects = <0x04 0x00 0x04 0x01>;
			operating-points-v2 = <0x05>;
			#cooling-cells = <0x02>;
			next-level-cache = <0x06>;
			phandle = <0x09>;

			l2-cache {
				compatible = "cache";
				cache-level = <0x02>;
				cache-unified;
				phandle = <0x06>;
			};
		};

		cpu@1 {
			device_type = "cpu";
			compatible = "qcom,kryo";
			reg = <0x00 0x01>;
			enable-method = "psci";
			cpu-idle-states = <0x02>;
			capacity-dmips-mhz = <0x400>;
			clocks = <0x03 0x00>;
			interconnects = <0x04 0x00 0x04 0x01>;
			operating-points-v2 = <0x05>;
			#cooling-cells = <0x02>;
			next-level-cache = <0x06>;
			phandle = <0x0a>;
		};

		cpu@100 {
			device_type = "cpu";
			compatible = "qcom,kryo";
			reg = <0x00 0x100>;
			enable-method = "psci";
			cpu-idle-states = <0x02>;
			capacity-dmips-mhz = <0x400>;
			clocks = <0x03 0x01>;
			interconnects = <0x04 0x00 0x04 0x01>;
			operating-points-v2 = <0x07>;
			#cooling-cells = <0x02>;
			next-level-cache = <0x08>;
			phandle = <0x0b>;

			l2-cache {
				compatible = "cache";
				cache-level = <0x02>;
				cache-unified;
				phandle = <0x08>;
			};
		};

		cpu@101 {
			device_type = "cpu";
			compatible = "qcom,kryo";
			reg = <0x00 0x101>;
			enable-method = "psci";
			cpu-idle-states = <0x02>;
			capacity-dmips-mhz = <0x400>;
			clocks = <0x03 0x01>;
			interconnects = <0x04 0x00 0x04 0x01>;
			operating-points-v2 = <0x07>;
			#cooling-cells = <0x02>;
			next-level-cache = <0x08>;
			phandle = <0x0c>;
		};

		cpu-map {

			cluster0 {

				core0 {
					cpu = <0x09>;
				};

				core1 {
					cpu = <0x0a>;
				};
			};

			cluster1 {

				core0 {
					cpu = <0x0b>;
				};

				core1 {
					cpu = <0x0c>;
				};
			};
		};

		idle-states {
			entry-method = "psci";

			cpu-sleep-0 {
				compatible = "arm,idle-state";
				idle-state-name = "standalone-power-collapse";
				arm,psci-suspend-param = <0x04>;
				entry-latency-us = <0x82>;
				exit-latency-us = <0x50>;
				min-residency-us = <0x12c>;
				phandle = <0x02>;
			};
		};
	};

	opp-table-cluster0 {
		compatible = "operating-points-v2-kryo-cpu";
		nvmem-cells = <0x0d>;
		opp-shared;
		phandle = <0x05>;

		opp-307200000 {
			opp-hz = <0x00 0x124f8000>;
			opp-supported-hw = <0x0f>;
			clock-latency-ns = <0x30d40>;
			opp-peak-kBps = <0x4b000>;
		};

		opp-422400000 {
			opp-hz = <0x00 0x192d5000>;
			opp-supported-hw = <0x0f>;
			clock-latency-ns = <0x30d40>;
			opp-peak-kBps = <0x4b000>;
		};

		opp-480000000 {
			opp-hz = <0x00 0x1c9c3800>;
			opp-supported-hw = <0x0f>;
			clock-latency-ns = <0x30d40>;
			opp-peak-kBps = <0x4b000>;
		};

		opp-556800000 {
			opp-hz = <0x00 0x21301800>;
			opp-supported-hw = <0x0f>;
			clock-latency-ns = <0x30d40>;
			opp-peak-kBps = <0x4b000>;
		};

		opp-652800000 {
			opp-hz = <0x00 0x26e8f000>;
			opp-supported-hw = <0x0f>;
			clock-latency-ns = <0x30d40>;
			opp-peak-kBps = <0x5dc00>;
		};

		opp-729600000 {
			opp-hz = <0x00 0x2b7cd000>;
			opp-supported-hw = <0x0f>;
			clock-latency-ns = <0x30d40>;
			opp-peak-kBps = "", "\a\b";
		};

		opp-844800000 {
			opp-hz = <0x00 0x325aa000>;
			opp-supported-hw = <0x0f>;
			clock-latency-ns = <0x30d40>;
			opp-peak-kBps = "", "\b4";
		};

		opp-960000000 {
			opp-hz = <0x00 0x39387000>;
			opp-supported-hw = <0x0f>;
			clock-latency-ns = <0x30d40>;
			opp-peak-kBps = "", "\nA";
		};

		opp-1036800000 {
			opp-hz = <0x00 0x3dcc5000>;
			opp-supported-hw = <0x0f>;
