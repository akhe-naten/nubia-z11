		};

		clock-controller@8c0000 {
			compatible = "qcom,mmcc-msm8996";
			#clock-cells = <0x01>;
			#reset-cells = <0x01>;
			#power-domain-cells = <0x01>;
			reg = <0x8c0000 0x40000>;
			clocks = <0x12 0x1c 0x01 0x1c 0x59 0x28 0x01 0x28 0x00 0x29 0x01 0x29 0x00 0x2a>;
			clock-names = "xo", "gpll0", "gcc_mmss_noc_cfg_ahb_clk", "dsi0pll", "dsi0pllbyte", "dsi1pll", "dsi1pllbyte", "hdmipll";
			assigned-clocks = <0x27 0x0f 0x27 0x03 0x27 0x07 0x27 0x09 0x27 0x0b>;
			assigned-clock-rates = <0x25317c00 0x30479e80 0x3a699d00 0x39387000 0x312c8040>;
			vdd-gfx-supply = <0x2b>;
			phandle = <0x27>;
		};

		display-subsystem@900000 {
			compatible = "qcom,mdss";
			reg = <0x900000 0x1000 0x9b0000 0x1040 0x9b8000 0x1040>;
			reg-names = "mdss_phys", "vbif_phys", "vbif_nrt_phys";
			power-domains = <0x27 0x0d>;
			interrupts = <0x00 0x53 0x04>;
			interrupt-controller;
			#interrupt-cells = <0x01>;
			clocks = <0x27 0x74 0x27 0x79>;
			clock-names = "iface", "core";
			resets = <0x27 0x1a>;
			#address-cells = <0x01>;
			#size-cells = <0x01>;
			ranges;
			status = "okay";
			phandle = <0x2c>;

			display-controller@901000 {
				compatible = "qcom,msm8996-mdp5", "qcom,mdp5";
				reg = <0x901000 0x90000>;
				reg-names = "mdp_phys";
				interrupt-parent = <0x2c>;
				interrupts = <0x00>;
				clocks = <0x27 0x74 0x27 0x76 0x27 0x79 0x27 0x5c 0x27 0x7b>;
				clock-names = "iface", "bus", "core", "iommu", "vsync";
				iommus = <0x2d 0x00>;
				assigned-clocks = <0x27 0x79 0x27 0x7b>;
				assigned-clock-rates = <0x11e1a300 0x124f800>;
				interconnects = <0x2e 0x03 0x2f 0x04 0x2e 0x04 0x2f 0x04 0x2e 0x05 0x2f 0x04>;
				interconnect-names = "mdp0-mem", "mdp1-mem", "rotator-mem";

				ports {
					#address-cells = <0x01>;
					#size-cells = <0x00>;

					port@0 {
						reg = <0x00>;

						endpoint {
							remote-endpoint = <0x30>;
							phandle = <0x40>;
						};
					};

					port@1 {
						reg = <0x01>;

						endpoint {
							remote-endpoint = <0x31>;
							phandle = <0x3a>;
						};
					};

					port@2 {
						reg = <0x02>;

						endpoint {
							remote-endpoint = <0x32>;
							phandle = <0x3f>;
						};
					};
				};
			};

			dsi@994000 {
				compatible = "qcom,msm8996-dsi-ctrl", "qcom,mdss-dsi-ctrl";
				reg = <0x994000 0x400>;
				reg-names = "dsi_ctrl";
				interrupt-parent = <0x2c>;
				interrupts = <0x04>;
				clocks = <0x27 0x79 0x27 0x7d 0x27 0x74 0x27 0x76 0x27 0x41 0x27 0x77 0x27 0x7f>;
				clock-names = "mdp_core", "byte", "iface", "bus", "core_mmss", "pixel", "core";
				assigned-clocks = <0x27 0x21 0x27 0x1b>;
				assigned-clock-parents = <0x28 0x00 0x28 0x01>;
				phys = <0x28>;
				status = "okay";
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				vdda-supply = <0x33>;
				vcca-supply = <0x1d>;
				vddio-supply = <0x34>;
				pinctrl-names = "default", "sleep";
				pinctrl-0 = <0x35 0x36>;
				pinctrl-1 = <0x37 0x38>;
				vdd-supply = <0x39>;

				ports {
					#address-cells = <0x01>;
					#size-cells = <0x00>;

					port@0 {
						reg = <0x00>;

						endpoint {
							remote-endpoint = <0x3a>;
							phandle = <0x31>;
						};
					};

					port@1 {
						reg = <0x01>;

						endpoint {
							status = "okay";
							data-lanes = <0x00 0x01 0x02 0x03>;
							remote-endpoint = <0x3b>;
							phandle = <0x3e>;
						};
					};
				};

				panel@0 {
					compatible = "jdi,fhd-r63452";
					reg = <0x00>;
