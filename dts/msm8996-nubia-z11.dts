	firmware {

		scm {
			compatible = "qcom,scm-msm8996", "qcom,scm";
			qcom,dload-mode = <0x0e 0x13000>;
		};
	};

	memory@80000000 {
		device_type = "memory";
		reg = <0x00 0x80000000 0x00 0x00>;
	};

	etm {
		compatible = "qcom,coresight-remote-etm";

		out-ports {

			port {

				endpoint {
					remote-endpoint = <0x0f>;
					phandle = <0x6e>;
				};
			};
		};
	};

	psci {
		compatible = "arm,psci-1.0";
		method = "smc";
	};

	remoteproc {
		compatible = "qcom,msm8996-rpm-proc", "qcom,rpm-proc";

		glink-edge {
			compatible = "qcom,glink-rpm";
			interrupts = <0x00 0xa8 0x01>;
			qcom,rpm-msg-ram = <0x10>;
			mboxes = <0x11 0x00>;

			rpm-requests {
				compatible = "qcom,rpm-msm8996", "qcom,glink-smd-rpm";
				qcom,glink-channels = "rpm_requests";

				clock-controller {
					compatible = "qcom,rpmcc-msm8996", "qcom,rpmcc";
					#clock-cells = <0x01>;
					clocks = <0x12>;
					clock-names = "xo";
					phandle = <0x1f>;
				};

				power-controller {
					compatible = "qcom,msm8996-rpmpd";
					#power-domain-cells = <0x01>;
					operating-points-v2 = <0x13>;
					phandle = <0x60>;

					opp-table {
						compatible = "operating-points-v2";
						phandle = <0x13>;

						opp1 {
							opp-level = <0x01>;
						};

						opp2 {
							opp-level = <0x02>;
						};

						opp3 {
							opp-level = <0x03>;
						};

						opp4 {
							opp-level = <0x04>;
						};

						opp5 {
							opp-level = <0x05>;
						};

						opp6 {
							opp-level = <0x06>;
						};
					};
				};

				regulators-0 {
					compatible = "qcom,rpm-pm8994-regulators";
					vdd_s1-supply = <0x14>;
					vdd_s2-supply = <0x14>;
					vdd_s3-supply = <0x14>;
					vdd_s4-supply = <0x14>;
					vdd_s5-supply = <0x14>;
					vdd_s6-supply = <0x14>;
					vdd_s7-supply = <0x14>;
					vdd_s8-supply = <0x14>;
					vdd_s9-supply = <0x14>;
					vdd_s10-supply = <0x14>;
					vdd_s11-supply = <0x14>;
					vdd_s12-supply = <0x14>;
					vdd_l1-supply = <0x15>;
					vdd_l2_l26_l28-supply = <0x16>;
					vdd_l3_l11-supply = <0x16>;
					vdd_l4_l27_l31-supply = <0x16>;
					vdd_l5_l7-supply = <0x17>;
					vdd_l6_l12_l32-supply = <0x17>;
					vdd_l8_l16_l30-supply = <0x14>;
					vdd_l9_l10_l18_l22-supply = <0x18>;
					vdd_l13_l19_l23_l24-supply = <0x18>;
					vdd_l14_l15-supply = <0x17>;
					vdd_l17_l29-supply = <0x18>;
					vdd_l20_l21-supply = <0x18>;
					vdd_l25-supply = <0x16>;
					vdd_lvs1_2-supply = <0x19>;

					s3 {
						regulator-name = "vreg_s3a_1p3";
						regulator-min-microvolt = <0x13d620>;
						regulator-max-microvolt = <0x13d620>;
						regulator-always-on;
						phandle = <0x16>;
					};

					s4 {
						regulator-name = "vreg_s4a_1p8";
						regulator-min-microvolt = <0x1b7740>;
						regulator-max-microvolt = <0x1b7740>;
						regulator-allow-set-load;
						regulator-always-on;
						phandle = <0x19>;
					};

					s5 {
						regulator-name = "vreg_s5a_2p15";
						regulator-min-microvolt = <0x20ce70>;
						regulator-max-microvolt = <0x20ce70>;
						phandle = <0x17>;
					};

					s7 {
						regulator-name = "vreg_s7a_0p8";
						regulator-min-microvolt = "", "\f5";
						regulator-max-microvolt = "", "\f5";
					};

					l1 {
						regulator-name = "vreg_l1a_1p0";
						regulator-min-microvolt = <0xf4240>;
						regulator-max-microvolt = <0xf4240>;
					};

					l2 {
						regulator-name = "vreg_l2a_1p25";
						regulator-min-microvolt = <0x1312d0>;
						regulator-max-microvolt = <0x1312d0>;
						phandle = <0x39>;
					};

					l4 {
						regulator-name = "vreg_l4a_1p225";
						regulator-min-microvolt = <0x12b128>;
						regulator-max-microvolt = <0x12b128>;
					};

					l6 {
						regulator-name = "vreg_l6a_1p8";
						regulator-min-microvolt = <0x1b7740>;
						regulator-max-microvolt = <0x1b7740>;
						phandle = <0xa9>;
					};

					l8 {
						regulator-name = "vreg_l8a_1p8";
						regulator-min-microvolt = <0x1b7740>;
						regulator-max-microvolt = <0x1b7740>;
					};

					l9 {
						regulator-name = "vreg_l9a_1p8";
						regulator-min-microvolt = <0x1b7740>;
						regulator-max-microvolt = <0x1b7740>;
					};

					l10 {
						regulator-name = "vreg_l10a_1p8";
						regulator-min-microvolt = <0x1b7740>;
						regulator-max-microvolt = <0x1b7740>;
					};

					l12 {
						regulator-name = "vreg_l12a_1p8";
						regulator-min-microvolt = <0x1b7740>;
						regulator-max-microvolt = <0x1b7740>;
						regulator-allow-set-load;
						phandle = <0x1e>;
					};

					l13 {
						regulator-name = "vreg_l13a_2p95";
						regulator-min-microvolt = <0x1b7740>;
						regulator-max-microvolt = <0x2d0370>;
					};

					l14 {
						regulator-name = "vreg_l14a_1p8";
						regulator-min-microvolt = <0x1b7740>;
						regulator-max-microvolt = <0x1b7740>;
						phandle = <0x34>;
					};

					l15 {
