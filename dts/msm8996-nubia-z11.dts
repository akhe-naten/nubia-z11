						power-source = <0x02>;
						bias-disable;
						phandle = <0xcf>;
					};

					wlan-en-state {
						pins = "gpio8";
						function = "normal";
						output-low;
						qcom,drive-strength = <0x03>;
						power-source = <0x02>;
						bias-disable;
						phandle = <0xd2>;
					};

					rome-enable-state {
						pins = "gpio9";
						function = "normal";
						output-high;
						qcom,drive-strength = <0x03>;
						power-source = <0x00>;
						phandle = <0xd1>;
					};

					divclk1-state {
						pins = "gpio15";
						function = "func1";
						bias-disable;
						power-source = <0x02>;
						qcom,drive-strength = <0x03>;
						phandle = <0xcc>;
					};

					divclk4-state {
						pins = "gpio18";
						function = "func2";
						bias-disable;
						power-source = <0x02>;
						phandle = <0xcd>;
					};

					divclk2-state {
						pins = "gpio16";
						function = "func2";
						bias-disable;
						power-source = <0x02>;
						phandle = <0xd3>;
					};
				};

				mpps@a000 {
					compatible = "qcom,pm8994-mpp", "qcom,spmi-mpp";
					reg = <0xa000>;
					gpio-controller;
					#gpio-cells = <0x02>;
					gpio-ranges = <0x46 0x00 0x00 0x08>;
					interrupt-controller;
					#interrupt-cells = <0x02>;
					gpio-line-names = "NC", "CCI_TIMER1", "PMIC_SLB", "EXT_FET_WLED_PWR_EN_N", "NC", "NC", "NC", "NC";
					phandle = <0x46>;
